# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxx

# ID Telegram kamu (cek lewat @userinfobot). Pisahkan dengan koma kalau lebih dari satu.
# PENTING: isi ini supaya orang lain tidak bisa memakai bot & Gmail kamu.
# Rekomendasi harian juga hanya dikirim ke ID yang ada di sini.
ALLOWED_USER_IDS=123456789

# ===== AI (OPSIONAL di sini) =====
# Lebih mudah diatur langsung dari bot: ⚙️ Pengaturan > 🤖 Model AI
# (pilih provider, pilih model dari daftar, simpan API key, tes AI).
# Pengaturan dari bot mengalahkan nilai di bawah ini.
# AI_PROVIDER=gemini                      # gemini / openai / claude / ollama
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx     # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite, gemini-2.5-flash   # cadangan saat sibuk/kuota habis
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # OpenAI-compatible: OpenRouter, Groq, DeepSeek, LM Studio, dll.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_FALLBACK_MODELS=
# CLAUDE_AUTH=key                         # key = pakai API key, login = pakai `ant auth login` di VPS
# ANTHROPIC_API_KEY=                      # JANGAN diisi (meski kosong) kalau CLAUDE_AUTH=login
# CLAUDE_MODEL=claude-sonnet-5-5
# OLLAMA_URL=http://localhost:11434       # https://ollama.com (gratis, lokal)
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_VISION_MODEL=qwen2.5vl:7b        # untuk membaca foto lowongan

# Gmail (OPSIONAL di sini). Lebih mudah tambah/ubah/hapus akun langsung dari bot:
# ⚙️ Pengaturan > 📧 Akun Gmail. Akun yang diisi di sini hanya bisa diubah lewat file ini.
# Pakai App Password, BUKAN password biasa. Tambah _2, _3, dst. untuk akun lain.
# GMAIL_ADDRESS=emailkamu@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Pengirim email job alert yang dibaca (cukup sebagian nama domain/pengirim)
ALERT_SENDERS=jobstreet,glints,linkedin,kalibrr,indeed
# Berapa hari ke belakang email dicek
ALERT_LOOKBACK_DAYS=3

# Skor di bawah angka ini -> CV otomatis disesuaikan dengan lowongan
CV_TAILOR_THRESHOLD=70
# Skor minimal supaya lowongan muncul sebagai rekomendasi
MIN_REC_SCORE=60
# Maksimal rekomendasi yang dikirim sekali cek
MAX_RECS=8

# Jadwal cek otomatis harian
DAILY_CHECK_TIME=08:00
TIMEZONE=Asia/Jakarta

# Berapa hari tanpa kabar sebelum diingatkan untuk follow-up
FOLLOWUP_DAYS=7
# Seberapa sering cek balasan HR di Gmail (menit)
REPLY_CHECK_MINUTES=60
