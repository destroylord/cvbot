# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxx

# ID Telegram kamu (cek lewat @userinfobot). Pisahkan dengan koma kalau lebih dari satu.
# PENTING: isi ini supaya orang lain tidak bisa memakai bot & Gmail kamu.
# Rekomendasi harian juga hanya dikirim ke ID yang ada di sini.
ALLOWED_USER_IDS=123456789

# ===== Pilih AI yang dipakai: gemini / ollama / claude =====
AI_PROVIDER=gemini

# Gemini (gratis dengan batas kuota): buat key di https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Ollama (gratis, jalan di komputer sendiri): install dari https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Model vision untuk membaca foto/poster lowongan (ollama pull qwen2.5vl:7b)
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Claude API (berbayar): key dari https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gmail (pakai App Password, BUKAN password biasa).
# Dipakai untuk mengirim lamaran DAN membaca email job alert.
GMAIL_ADDRESS=emailkamu@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Akun Gmail tambahan (opsional). Job alert dibaca dari semua akun, dan saat mengirim
# lamaran kamu bisa pilih akun pengirimnya. Tambah _3, _4, dst. kalau perlu.
# GMAIL_ADDRESS_2=emaillain@gmail.com
# GMAIL_APP_PASSWORD_2=qrst uvwx yzab cdef

# Pengirim email job alert yang dibaca (cukup sebagian nama domain/pengirim)
ALERT_SENDERS=jobstreet,glints,linkedin,kalibrr,indeed
# Berapa hari ke belakang email dicek
ALERT_LOOKBACK_DAYS=3

# Skor di bawah angka ini -> CV otomatis disesuaikan dengan lowongan
CV_TAILOR_THRESHOLD=70
# Skor minimal supaya lowongan muncul sebagai rekomendasi
MIN_REC_SCORE=60
# Maksimal rekomendasi yang dikirim sekali cek
MAX_RECS=8

# Jadwal cek otomatis harian
DAILY_CHECK_TIME=08:00
TIMEZONE=Asia/Jakarta

# Berapa hari tanpa kabar sebelum diingatkan untuk follow-up
FOLLOWUP_DAYS=7
# Seberapa sering cek balasan HR di Gmail (menit)
REPLY_CHECK_MINUTES=60
